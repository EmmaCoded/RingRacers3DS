; Ring Racers 3DS - vertex shader of the GPU 3D renderer (r_citro3d)
; pos = projection * modelView * (x,y,z,1); uv passed straight through (units 0 and 1).
; distance light like Software mode / PC shader
; (R_DoomColormap): color.a = how much light is left (1 = not darkened).
;   lightp.x = startmap * 1.06 ; lightp.y = cap  (computed on the CPU)
.fvec projection[4], modelView[4], lightp
.constf myconst(0.0, 1.0, 0.0625, 127.0)
.constf myconst2(92.0, 31.0, 0.03125, 0.0)
.alias ones myconst.yyyy
.out outpos position
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outclr color
.alias inpos v0
.alias intex v1
.proc main
	mov r0.xyz, inpos
	mov r0.w, ones
	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0
	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1
	mov outtc0, intex
	mov outtc1, intex
	; z distance (the camera looks toward -z) -> lightz = clamp(z/16, 0, 127)
	mul r2.x, myconst.z, -r1.z
	max r2.x, myconst.x, r2.x
	min r2.x, myconst.w, r2.x
	; scale*0.5*1.15 = 92 / (lightz + 1)
	add r2.x, myconst.y, r2.x
	rcp r2.x, r2.x
	mul r2.x, myconst2.x, r2.x
	; colormap = clamp(max(startmap - scale, cap), 0, 31) / 32
	add r2.x, lightp.x, -r2.x
	max r2.x, lightp.y, r2.x
	max r2.x, myconst.x, r2.x
	min r2.x, myconst2.y, r2.x
	mul r2.x, myconst2.z, r2.x
	add r2.x, myconst.y, -r2.x
	mov outclr.xyz, ones
	mov outclr.w, r2.x
	end
.end
